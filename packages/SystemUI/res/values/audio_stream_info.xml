<resources>
    <!-- Generic codec label when Bluetooth does not provide a usable codec name. -->
    <string name="audio_stream_info_unknown_codec">Bluetooth audio</string>
    <!-- Output transport labels. These do not assert active sample rate or playback quality. -->
    <string name="audio_stream_info_usb_audio">USB audio</string>
    <string name="audio_stream_info_wired_audio">Wired audio</string>
    <!-- A single sample rate reported by Bluetooth, in kilohertz. -->
    <string name="audio_stream_info_sample_rate">%1$s kHz</string>
    <!-- PCM bit depth reported in the Bluetooth codec configuration. -->
    <string name="audio_stream_info_bit_depth">%1$d-bit</string>
    <!-- Separator for the codec name and known configuration fields. -->
    <string name="audio_stream_info_join">%1$s · %2$s</string>
    <!-- Value for a diagnostic field not supplied by the active output. -->
    <string name="audio_stream_info_not_reported">Not reported</string>
    <string name="audio_stream_info_bluetooth_connection">Bluetooth A2DP</string>
    <string name="audio_stream_info_bluetooth_note">Format reported by Bluetooth. Transmission bitrate and bit-perfect playback are not reported.</string>
    <string name="audio_stream_info_wired_note">Current hardware sample rate, bit depth, and playback path are not reported by this view.</string>
    <!-- Bluetooth diagnostics; arguments are codec, negotiated sample rate, and PCM bit depth. -->
    <string name="audio_stream_info_bluetooth_details">Codec: %1$s\nSample rate: %2$s\nBit depth: %3$s\nTransport: Bluetooth A2DP\nBitrate: Not reported\nPlayback path: Not reported</string>
    <!-- Connection capabilities do not establish the active hardware stream format. -->
    <string name="audio_stream_info_wired_details">Connection: %1$s\nActive hardware sample rate: Not reported\nBit depth: Not reported\nPlayback path: Not reported</string>
</resources>
